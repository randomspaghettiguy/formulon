{
  "name": "formulon",
  "version": "0.0.0-development",
  "description": "Salesforce formula parser and evaluator: every documented function, linear-time, no dependencies",
  "main": "lib/formulon.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "vitest",
    "lint": "eslint .",
    "size": "node scripts/size.mjs",
    "cases:merge": "node scripts/cases-to-csv.mjs",
    "commitlint": "commitlint",
    "semantic-release": "semantic-release",
    "cases:report": "node scripts/cases-report.mjs",
    "verify:org": "node scripts/verify-org.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leifg/formulon.git"
  },
  "keywords": [
    "parser",
    "salesforce",
    "formula"
  ],
  "author": "Leif Gensert",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/config-conventional": "^20.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^24.0.1",
    "@vitest/eslint-plugin": "^1.1.36",
    "commitlint": "^20.1.0",
    "eslint": "^9.25.1",
    "rollup": "^4.40.1",
    "semantic-release": "^25.0.1",
    "vitest": "^4.0.3",
    "@eslint/js": "^9.25.1"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "module": "lib/formulon.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./lib/formulon.mjs",
      "require": "./lib/formulon.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "index.d.ts"
  ],
  "sideEffects": false,
  "type": "module"
}
